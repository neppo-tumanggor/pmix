{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@pmix/backend/*": ["apps/backend/src/*"],
      "@pmix/frontend/*": ["apps/frontend/src/*"],
      "@pmix/shared-types": ["packages/shared-types/src"],
      "@pmix/shared-ui": ["packages/shared-ui/src"],
      "@pmix/shared-utils": ["packages/shared-utils/src"]
    }
  }
}
