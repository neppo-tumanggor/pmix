# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=mixer
DB_PASSWORD=mixer123
DB_DATABASE=mixer_dev
DB_SSL=false

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this
JWT_REFRESH_EXPIRY=30d

# CORS
CORS_ORIGIN=http://localhost:4080

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mixer.com

# Storage (optional)
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100