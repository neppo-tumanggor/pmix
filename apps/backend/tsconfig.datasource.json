{
    "include":  [
                    "./src/data-source.ts",
                    "./src/migrations/**/*.ts",
                    "./src/modules/**/*.entity.ts"
                ],
    "exclude":  [
                    "node_modules",
                    "dist",
                    "**/*.test.ts",
                    "**/*.spec.ts"
                ],
    "compilerOptions":  {
                            "target":  "ES2021",
                            "moduleResolution":  "Node16",
                            "module":  "Node16",
                            "forceConsistentCasingInFileNames":  true,
                            "types":  [
                                          "node"
                                      ],
                            "skipLibCheck":  true,
                            "strict":  false,
                            "ignoreDeprecations":  "6.0",
                            "emitDecoratorMetadata":  true,
                            "rootDir":  "./src",
                            "outDir":  "./dist",
                            "experimentalDecorators":  true,
                            "noEmitOnError":  false,
                            "esModuleInterop":  true,
                            "resolveJsonModule":  true
                        }
}
