{
  "name": "@pmix/backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "NestJS Backend API Service",
  "scripts": {
    "build": "nest build -b tsc",
    "start": "nest start",
    "start:dev": "ts-node --transpile-only -r tsconfig-paths/register src/main.ts",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "type-check": "tsc --noEmit",
    "build:datasource": "tsc -p tsconfig.datasource.json",
    "db:migrate": "pnpm build:datasource && typeorm migration:run -d dist/data-source.js",
    "db:rollback": "pnpm build:datasource && typeorm migration:revert -d dist/data-source.js",
    "db:generate": "pnpm build:datasource && typeorm migration:generate -d dist/data-source.js -n",
    "db:seed": "ts-node src/migrations/seed/seed.ts",
    "clean": "rm -rf dist .turbo",
    "perf:test": "ts-node --transpile-only -r tsconfig-paths/register src/modules/products/scripts/run-performance-test.ts",
    "perf:seed": "ts-node --transpile-only -r tsconfig-paths/register src/modules/products/scripts/seed-for-user.ts"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.3.7",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^5.0.0",
    "@pmix/shared-types": "workspace:*",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.9",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sql.js": "^1.14.2",
    "sqlite3": "^6.0.1",
    "sqljs": "0.0.0-6",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-jwt": "^4.0.0",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2",
    "webpack": "^5.110.3",
    "webpack-node-externals": "^3.0.0"
  }
}